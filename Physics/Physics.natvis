<?xml version="1.0" encoding="utf-8"?>

<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="GLEngine::Physics::Primitives::S_AABB">
    <AlternativeType Name="GLEngine::Physics::Primitives::S_SSEAABB"/>
    <Intrinsic Name="IsInitialized" Expression="isinf(m_Min.x)"/>
    <DisplayString Condition="IsInitialized()">{m_Min}-{m_Max}</DisplayString>
    <DisplayString Condition="!IsInitialized()">invalid AABB</DisplayString>
    <Expand>
      <Item Name="[Min]" Condition="IsInitialized()">m_Min</Item>
      <Item Name="[Max]" Condition="IsInitialized()">m_Max</Item>
      <Synthetic  Name="sides" Condition="IsInitialized()">
        <DisplayString>UNINITALIZED</DisplayString>
      </Synthetic>
    </Expand>
  </Type>
  <Type Name="GLEngine::Physics::Primitives::S_Disc">
    <DisplayString>{plane}:{radius}</DisplayString>
    <Expand>
      <Item Name="[Plane]">plane</Item>
      <Item Name="[Radius]">radius</Item>
    </Expand>
  </Type>
  <Type Name="GLEngine::Physics::Primitives::S_Triangle">
    <DisplayString>{{{m_p[0]} - {m_p[1]} - {m_p[2]}}}</DisplayString>
    <Expand>
      <Item Name="[Vertices]">m_p._Elems,3</Item>
      <Item Name="[Normal]">m_Normal</Item>
      <Item Name="[Area]">m_Area</Item>
    </Expand>
  </Type>
  <Type Name="GLEngine::Physics::Primitives::S_Plane">
    <DisplayString Condition="twoSided">P:{origin} N:{normal} two-sided</DisplayString>
    <DisplayString Condition="!twoSided">P:{origin} N:{normal} one-sided</DisplayString>
    <Expand>
      <Item Name="[Origin]">origin</Item>
      <Item Name="[Normal]">normal</Item>
      <Synthetic  Name="sides">
        <DisplayString Condition="twoSided">two-sided</DisplayString>
        <DisplayString Condition="!twoSided">one-sided</DisplayString>
      </Synthetic>
    </Expand>
  </Type>
  <Type Name="GLEngine::Physics::Primitives::S_SSEAABB">
    <Intrinsic Name="IsInitialized" Expression="!isinf(m_Min.data.m128_f32[0])"/>
    <DisplayString Condition="IsInitialized()">{m_Min} - {m_Max}</DisplayString>
    <DisplayString Condition="!IsInitialized()">invalid AABB</DisplayString>
    <Expand>
      <Item Name="[Min]" Condition="IsInitialized()">m_Min</Item>
      <Item Name="[Max]" Condition="IsInitialized()">m_Max</Item>
    </Expand>
  </Type>

  <!-- Quantities -->
  <Type Name="DULib::StrongType&lt;float, GLEngine::Physics::Scalars::distance_tag&gt;">
    <DisplayString Condition="m_Value > 1">{m_Value}m</DisplayString>
    <DisplayString Condition="m_Value &lt; 1 &amp;&amp; m_Value &gt; 0.1">{(m_Value * 100),g}cm</DisplayString>
    <DisplayString Condition="m_Value &lt; 0.1">{m_Value * 1000}mm</DisplayString>
    <Expand>
      <Item Name="[m]">m_Value</Item>
      <Item Name="[cm]">m_Value * 100</Item>
      <Item Name="[mm]">m_Value * 1000</Item>
    </Expand>
  </Type>
</AutoVisualizer>